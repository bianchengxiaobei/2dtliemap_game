<rml>
<head>
    <title>ZomboidLike Inventory</title>
    <link type="text/rcss" href="theme.rcss"/>
    <link type="text/rcss" href="inventory.rcss"/>
</head>
<body>
    <div id="inventory-overlay">
        <div id="inventory-panel">
            <div class="inv-header">
                <span class="inv-title">背包</span>
                <span id="inv-weight" class="inv-weight">0.0 / 20.0 kg</span>
                <div id="inventory-close" class="inv-close">X</div>
            </div>
            <div class="inv-columns">
                <div class="inv-column-left">
                    <div class="inv-section-title">装备</div>
                    <div class="equip-row">
                        <div id="equip-slot-0" class="inv-slot equip-slot" data-area="equipment" data-index="0">
                            <div class="inv-kind">主手</div>
                            <div id="equip-name-0" class="inv-name">空</div>
                            <div id="equip-count-0" class="inv-count"></div>
                        </div>
                        <div id="equip-slot-1" class="inv-slot equip-slot" data-area="equipment" data-index="1">
                            <div class="inv-kind">躯干</div>
                            <div id="equip-name-1" class="inv-name">空</div>
                            <div id="equip-count-1" class="inv-count"></div>
                        </div>
                    </div>
                    <div class="inv-section-title">背包 <span id="bag-stack-count" class="inv-count-label">0 堆</span></div>
                    <div id="bag-grid" class="inv-grid">
                        <div id="bag-slot-0" class="inv-slot" data-area="bag" data-index="0"><div id="bag-name-0" class="inv-name">空</div><div id="bag-count-0" class="inv-count"></div></div>
                        <div id="bag-slot-1" class="inv-slot" data-area="bag" data-index="1"><div id="bag-name-1" class="inv-name">空</div><div id="bag-count-1" class="inv-count"></div></div>
                        <div id="bag-slot-2" class="inv-slot" data-area="bag" data-index="2"><div id="bag-name-2" class="inv-name">空</div><div id="bag-count-2" class="inv-count"></div></div>
                        <div id="bag-slot-3" class="inv-slot" data-area="bag" data-index="3"><div id="bag-name-3" class="inv-name">空</div><div id="bag-count-3" class="inv-count"></div></div>
                        <div id="bag-slot-4" class="inv-slot" data-area="bag" data-index="4"><div id="bag-name-4" class="inv-name">空</div><div id="bag-count-4" class="inv-count"></div></div>
                        <div id="bag-slot-5" class="inv-slot" data-area="bag" data-index="5"><div id="bag-name-5" class="inv-name">空</div><div id="bag-count-5" class="inv-count"></div></div>
                        <div id="bag-slot-6" class="inv-slot" data-area="bag" data-index="6"><div id="bag-name-6" class="inv-name">空</div><div id="bag-count-6" class="inv-count"></div></div>
                        <div id="bag-slot-7" class="inv-slot" data-area="bag" data-index="7"><div id="bag-name-7" class="inv-name">空</div><div id="bag-count-7" class="inv-count"></div></div>
                        <div id="bag-slot-8" class="inv-slot" data-area="bag" data-index="8"><div id="bag-name-8" class="inv-name">空</div><div id="bag-count-8" class="inv-count"></div></div>
                        <div id="bag-slot-9" class="inv-slot" data-area="bag" data-index="9"><div id="bag-name-9" class="inv-name">空</div><div id="bag-count-9" class="inv-count"></div></div>
                        <div id="bag-slot-10" class="inv-slot" data-area="bag" data-index="10"><div id="bag-name-10" class="inv-name">空</div><div id="bag-count-10" class="inv-count"></div></div>
                        <div id="bag-slot-11" class="inv-slot" data-area="bag" data-index="11"><div id="bag-name-11" class="inv-name">空</div><div id="bag-count-11" class="inv-count"></div></div>
                        <div id="bag-slot-12" class="inv-slot" data-area="bag" data-index="12"><div id="bag-name-12" class="inv-name">空</div><div id="bag-count-12" class="inv-count"></div></div>
                        <div id="bag-slot-13" class="inv-slot" data-area="bag" data-index="13"><div id="bag-name-13" class="inv-name">空</div><div id="bag-count-13" class="inv-count"></div></div>
                        <div id="bag-slot-14" class="inv-slot" data-area="bag" data-index="14"><div id="bag-name-14" class="inv-name">空</div><div id="bag-count-14" class="inv-count"></div></div>
                        <div id="bag-slot-15" class="inv-slot" data-area="bag" data-index="15"><div id="bag-name-15" class="inv-name">空</div><div id="bag-count-15" class="inv-count"></div></div>
                        <div id="bag-slot-16" class="inv-slot" data-area="bag" data-index="16"><div id="bag-name-16" class="inv-name">空</div><div id="bag-count-16" class="inv-count"></div></div>
                        <div id="bag-slot-17" class="inv-slot" data-area="bag" data-index="17"><div id="bag-name-17" class="inv-name">空</div><div id="bag-count-17" class="inv-count"></div></div>
                        <div id="bag-slot-18" class="inv-slot" data-area="bag" data-index="18"><div id="bag-name-18" class="inv-name">空</div><div id="bag-count-18" class="inv-count"></div></div>
                        <div id="bag-slot-19" class="inv-slot" data-area="bag" data-index="19"><div id="bag-name-19" class="inv-name">空</div><div id="bag-count-19" class="inv-count"></div></div>
                        <div id="bag-slot-20" class="inv-slot" data-area="bag" data-index="20"><div id="bag-name-20" class="inv-name">空</div><div id="bag-count-20" class="inv-count"></div></div>
                        <div id="bag-slot-21" class="inv-slot" data-area="bag" data-index="21"><div id="bag-name-21" class="inv-name">空</div><div id="bag-count-21" class="inv-count"></div></div>
                        <div id="bag-slot-22" class="inv-slot" data-area="bag" data-index="22"><div id="bag-name-22" class="inv-name">空</div><div id="bag-count-22" class="inv-count"></div></div>
                        <div id="bag-slot-23" class="inv-slot" data-area="bag" data-index="23"><div id="bag-name-23" class="inv-name">空</div><div id="bag-count-23" class="inv-count"></div></div>
                        <div id="bag-slot-24" class="inv-slot" data-area="bag" data-index="24"><div id="bag-name-24" class="inv-name">空</div><div id="bag-count-24" class="inv-count"></div></div>
                    </div>
                </div>
                <div class="inv-column-right">
                    <div class="inv-section-title">附近地面 <span id="loot-stack-count" class="inv-count-label">0 堆</span></div>
                    <div id="loot-grid" class="inv-grid loot-grid">
                        <div id="loot-slot-0" class="inv-slot loot-slot" data-area="loot" data-index="0"><div id="loot-name-0" class="inv-name">无</div><div id="loot-count-0" class="inv-count"></div></div>
                        <div id="loot-slot-1" class="inv-slot loot-slot" data-area="loot" data-index="1"><div id="loot-name-1" class="inv-name">无</div><div id="loot-count-1" class="inv-count"></div></div>
                        <div id="loot-slot-2" class="inv-slot loot-slot" data-area="loot" data-index="2"><div id="loot-name-2" class="inv-name">无</div><div id="loot-count-2" class="inv-count"></div></div>
                        <div id="loot-slot-3" class="inv-slot loot-slot" data-area="loot" data-index="3"><div id="loot-name-3" class="inv-name">无</div><div id="loot-count-3" class="inv-count"></div></div>
                        <div id="loot-slot-4" class="inv-slot loot-slot" data-area="loot" data-index="4"><div id="loot-name-4" class="inv-name">无</div><div id="loot-count-4" class="inv-count"></div></div>
                        <div id="loot-slot-5" class="inv-slot loot-slot" data-area="loot" data-index="5"><div id="loot-name-5" class="inv-name">无</div><div id="loot-count-5" class="inv-count"></div></div>
                    </div>
                    <div class="craft-toolbar">
                        <div class="inv-section-title">制作 <div id="craft-page-prev" class="craft-page-btn disabled">&#8249;</div><span id="craft-count" class="inv-count-label">0 条</span><span id="craft-page-indicator" class="craft-page-indicator">1/1 页</span><div id="craft-page-next" class="craft-page-btn disabled">&#8250;</div></div>
                        <div class="craft-qty">
                            <div class="craft-qty-label">数量</div>
                            <div id="craft-qty-minus" class="craft-qty-btn disabled">-</div>
                            <div id="craft-qty-value" class="craft-qty-value">1</div>
                            <div id="craft-qty-plus" class="craft-qty-btn">+</div>
                        </div>
                    </div>
                    <div id="craft-list" class="craft-list">
                        <div id="craft-row-0" class="craft-row">
                            <div class="craft-info">
                                <div id="craft-name-0" class="craft-name">—</div>
                                <div id="craft-ing-0" class="craft-ing">—</div>
                            </div>
                            <div id="craft-state-0" class="craft-state">—</div>
                            <div id="craft-btn-0" class="craft-btn">制作</div>
                        </div>
                        <div id="craft-row-1" class="craft-row">
                            <div class="craft-info">
                                <div id="craft-name-1" class="craft-name">—</div>
                                <div id="craft-ing-1" class="craft-ing">—</div>
                            </div>
                            <div id="craft-state-1" class="craft-state">—</div>
                            <div id="craft-btn-1" class="craft-btn">制作</div>
                        </div>
                        <div id="craft-row-2" class="craft-row">
                            <div class="craft-info">
                                <div id="craft-name-2" class="craft-name">—</div>
                                <div id="craft-ing-2" class="craft-ing">—</div>
                            </div>
                            <div id="craft-state-2" class="craft-state">—</div>
                            <div id="craft-btn-2" class="craft-btn">制作</div>
                        </div>
                        <div id="craft-row-3" class="craft-row">
                            <div class="craft-info">
                                <div id="craft-name-3" class="craft-name">—</div>
                                <div id="craft-ing-3" class="craft-ing">—</div>
                            </div>
                            <div id="craft-state-3" class="craft-state">—</div>
                            <div id="craft-btn-3" class="craft-btn">制作</div>
                        </div>
                    </div>
                    <div id="craft-progress" class="craft-progress">
                        <div id="craft-progress-label" class="craft-progress-label">制作中</div>
                        <div id="craft-progress-time" class="craft-progress-time">0.0 / 0.0 秒</div>
                        <div id="craft-cancel" class="craft-cancel">取消</div>
                        <div class="craft-progress-track">
                            <div id="craft-progress-fill" class="craft-progress-fill"></div>
                        </div>
                        <div id="craft-queue-row" class="craft-queue-row">
                            <div id="craft-queue-prev" class="craft-queue-btn">&#8249;</div>
                            <div id="craft-queue-label" class="craft-queue-label">队列: 空</div>
                            <div id="craft-queue-next" class="craft-queue-btn">&#8250;</div>
                            <div id="craft-queue-up" class="craft-queue-btn">&#8593;</div>
                            <div id="craft-queue-down" class="craft-queue-btn">&#8595;</div>
                            <div id="craft-queue-dec" class="craft-queue-btn">&#8722;</div>
                            <div id="craft-queue-inc" class="craft-queue-btn">+</div>
                            <div id="craft-queue-remove" class="craft-queue-btn craft-queue-remove">&#215;</div>
                        </div>
                    </div>
                    <div class="inv-hint">拖动：交换/装备/地面。右键：装备、使用、维修、丢弃、拾取。制作完成才扣料；数量支持批量，材料/空间不足自动截断；制作中“加入”排队，用 &lt; &gt; 选择、↑↓ 调序、−/+ 改数量、× 移除；配方多时用 ‹ › 翻页。缺工具需携带，制作站需靠近；未学会需看杂志。</div>
                    <div id="inv-status" class="inv-status status-info"></div>
                </div>
            </div>
        </div>
        <div id="context-menu" class="context-menu">
            <div id="ctx-use" class="ctx-btn">使用</div>
            <div id="ctx-equip" class="ctx-btn">装备</div>
            <div id="ctx-unequip" class="ctx-btn">卸下</div>
            <div id="ctx-drop" class="ctx-btn">丢弃</div>
            <div id="ctx-pickup" class="ctx-btn">拾取</div>
            <div id="ctx-repair" class="ctx-btn">维修</div>
        </div>
    </div>
</body>
</rml>
