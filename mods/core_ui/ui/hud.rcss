body {
    font-family: zl_ui;
    font-size: 13px;
    color: #e6edf3;
    width: 100%;
    height: 100%;
}

.hud-box {
    position: absolute;
    background-color: #10161de8;
    border-width: 1px;
    border-color: #34495c;
    border-radius: 10px;
}

#hud-clock {
    top: 12px;
    left: 50%;
    margin-left: -90px;
    width: 180px;
    padding: 6px 10px;
    text-align: center;
}

.hud-day {
    font-size: 11px;
    color: #9fb3c8;
}

.hud-clock-row {
    height: 30px;
    line-height: 30px;
}

.hud-time {
    display: inline-block;
    font-size: 22px;
    color: #ffffff;
    vertical-align: top;
}

.hud-speed {
    display: inline-block;
    margin-left: 8px;
    margin-top: 5px;
    padding: 1px 7px;
    background-color: #243444;
    border-width: 1px;
    border-color: #3d566d;
    border-radius: 8px;
    font-size: 11px;
    line-height: 18px;
    color: #ffd479;
    vertical-align: top;
}

.hud-speed.paused {
    background-color: #4a2b2b;
    border-color: #8a4a4a;
    color: #ff9a8a;
}

#hud-right {
    display: block;
    position: absolute;
    top: 12px;
    right: 16px;
    width: 332px;
    min-height: 136px;
    pointer-events: none;
}

#hud-objective {
    position: relative;
    top: 0;
    right: 0;
    width: 310px;
    padding: 8px 10px;
}

.objective-label {
    font-size: 11px;
    color: #9fb3c8;
}

.objective-text {
    margin-top: 3px;
    font-size: 13px;
    line-height: 18px;
    color: #ffd479;
}

.objective-text.objective-warn {
    color: #ffb86b;
}

.objective-text.objective-ok {
    color: #7fe08a;
}

.objective-hint {
    margin-top: 3px;
    font-size: 11px;
    line-height: 16px;
    color: #9fb3c8;
}

.poi-guide {
    margin-top: 4px;
    font-size: 11px;
    line-height: 16px;
    color: #9fd7ff;
}

.poi-guide.status-warn {
    color: #ffd479;
}

.poi-guide.status-ok {
    color: #7fe08a;
}

.mission-guide {
    margin-top: 4px;
    font-size: 11px;
    line-height: 16px;
    color: #c7b3ff;
}

.mission-guide.status-warn {
    color: #ffd479;
}

.mission-guide.status-ok {
    color: #7fe08a;
}

.event-guide {
    margin-top: 4px;
    font-size: 11px;
    line-height: 16px;
    color: #ffb86b;
}

.event-guide.status-warn {
    color: #ffb86b;
}

.event-guide.status-ok {
    color: #7fe08a;
}

.event-guide.status-fail {
    color: #ff8a7a;
}

.region-guide {
    margin-top: 4px;
    font-size: 11px;
    line-height: 16px;
    color: #9fb3c8;
}

.region-guide.status-warn {
    color: #ffd479;
}

.region-guide.status-ok {
    color: #7fe08a;
}

.settlement-guide {
    margin-top: 4px;
    font-size: 11px;
    line-height: 16px;
    color: #8fd3ff;
}

.settlement-guide.status-warn {
    color: #ffd479;
}

.settlement-guide.status-fail {
    color: #ff8a7a;
}

.settlement-guide.status-ok {
    color: #7fe08a;
}

.strategic-guide {
    margin-top: 4px;
    font-size: 11px;
    line-height: 16px;
    color: #ffb86b;
}

.strategic-guide.status-warn {
    color: #ffd479;
}

.strategic-guide.status-fail {
    color: #ff8a7a;
}

#hud-left {
    display: block;
    position: absolute;
    left: 16px;
    bottom: 16px;
    width: 260px;
    pointer-events: none;
}

#hud-vitals {
    position: relative;
    left: 0;
    bottom: 0;
    width: 260px;
    padding: 8px 10px;
}

.vital-row {
    height: 21px;
    line-height: 21px;
}

.vital-label {
    display: inline-block;
    width: 34px;
    font-size: 13px;
    color: #9fb3c8;
    vertical-align: top;
}

.vital-track {
    display: inline-block;
    width: 150px;
    height: 10px;
    margin-top: 5px;
    background-color: #0b1117;
    border-width: 1px;
    border-color: #2c3e4f;
    border-radius: 5px;
    vertical-align: top;
}

.vital-fill {
    height: 10px;
    border-radius: 5px;
}

.hp {
    width: 100%;
    background-color: #d9534f;
}

.stamina {
    width: 100%;
    background-color: #d4b24a;
}

.needs-status {
    margin-top: 4px;
    font-size: 11px;
    line-height: 15px;
    color: #9fb3c8;
}

.ranged-status {
    margin-top: 2px;
    color: #e5c97b;
}

.forage-status {
    margin-top: 2px;
    color: #a7df9a;
}

.fishing-status {
    margin-top: 1px;
    color: #9fd7ff;
}

.needs-status.status-warn {
    color: #ffd479;
}

.needs-status.status-fail {
    color: #ff8a7a;
}

.wound-status {
    margin-top: 1px;
}

.pain-status {
    margin-top: 1px;
}

.armor-status {
    margin-top: 1px;
}

.infection-status {
    margin-top: 1px;
}

.weather-status {
    margin-top: 1px;
    color: #a9c7d9;
}

.weather-overlay {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    display: none;
    pointer-events: none;
}

.weather-overlay.weather-rain {
    display: block;
    background-color: #24425f3a;
}

.weather-overlay.weather-fog {
    display: block;
    background-color: #aeb9c22e;
}

.weather-overlay.weather-cold {
    display: block;
    background-color: #7fbfff24;
}

.vital-fill.low {
    background-color: #ff4040;
}

.vital-value {
    display: inline-block;
    width: 40px;
    text-align: right;
    font-size: 13px;
    color: #d7e2ec;
    vertical-align: top;
}

#hotbar {
    position: absolute;
    left: 50%;
    bottom: 16px;
    margin-left: -180px;
    width: 360px;
    height: 64px;
}

.slot {
    display: inline-block;
    position: relative;
    width: 64px;
    height: 64px;
    margin-right: 6px;
    background-color: #10161de8;
    border-width: 1px;
    border-color: #34495c;
    border-radius: 8px;
    vertical-align: top;
}

.slot:last-child {
    margin-right: 0px;
}

.slot.selected {
    background-color: #243444;
    border-color: #ffd479;
}

.slot-key {
    position: absolute;
    left: 6px;
    top: 2px;
    font-size: 11px;
    color: #9fb3c8;
}

.slot-name {
    position: absolute;
    left: 3px;
    right: 3px;
    top: 20px;
    height: 32px;
    font-size: 11px;
    line-height: 16px;
    text-align: center;
    color: #d7e2ec;
    overflow: hidden;
    text-overflow: ellipsis;
    word-break: break-word;
}

.slot-count {
    position: absolute;
    right: 5px;
    bottom: 2px;
    font-size: 11px;
    color: #ffd479;
}

#hud-bag {
    position: absolute;
    right: 16px;
    bottom: 16px;
    width: 100px;
    height: 38px;
    line-height: 38px;
    padding: 0 10px;
    background-color: #10161de8;
    border-width: 1px;
    border-color: #34495c;
    border-radius: 9px;
    cursor: pointer;
}

#hud-bag:hover {
    background-color: #243444;
    border-color: #ffd479;
}

.hud-bag-label {
    font-size: 13px;
    color: #d7e2ec;
}

.hud-bag-key {
    display: inline-block;
    margin-left: 8px;
    padding: 0 5px;
    background-color: #243444;
    border-width: 1px;
    border-color: #3d566d;
    border-radius: 4px;
    font-size: 11px;
    line-height: 17px;
    color: #9fb3c8;
    vertical-align: middle;
}

#action-hint {
    position: absolute;
    left: 50%;
    bottom: 86px;
    margin-left: -310px;
    width: 620px;
    display: none;
    text-align: center;
    font-size: 12px;
    line-height: 18px;
    color: #d7e2ec;
}

#action-hint.status-warn {
    color: #ffd479;
}

#action-hint.status-fail {
    color: #ff8a7a;
}

#dialogue-panel {
    position: absolute;
    left: 50%;
    bottom: 150px;
    margin-left: -330px;
    width: 660px;
    display: none;
    z-index: 20;
}

.dialogue-card {
    padding: 12px 18px 10px 18px;
    background-color: #10161df2;
    border-width: 1px;
    border-color: #4d6a83;
    border-radius: 10px;
}

.dialogue-speaker {
    font-size: 15px;
    font-weight: bold;
    color: #ffd479;
}

.dialogue-text {
    margin-top: 5px;
    font-size: 14px;
    line-height: 21px;
    color: #e4edf5;
}

.dialogue-option {
    display: none;
    margin-top: 4px;
    padding: 2px 7px;
    font-size: 13px;
    line-height: 19px;
    color: #d7e2ec;
    border-radius: 4px;
}

.dialogue-option.selected {
    background-color: #1a2a38;
    color: #ffd479;
}

.dialogue-hint {
    margin-top: 8px;
    padding-top: 7px;
    border-top-width: 1px;
    border-color: #2c3e4f;
    font-size: 11px;
    color: #9fb3c8;
}

#notice {
    position: absolute;
    left: 50%;
    bottom: 130px;
    margin-left: -180px;
    width: 360px;
    display: none;
    text-align: center;
    font-size: 15px;
    font-weight: bold;
    color: #ffd479;
}

.notice-info {
    color: #ffd479;
}

.notice-ok {
    color: #7fe08a;
}

.notice-fail {
    color: #ff8a7a;
}

.threat-edge {
    position: absolute;
    display: none;
    pointer-events: none;
    background-color: #ff4a3d;
}

.threat-left {
    left: 0;
    top: 18%;
    width: 10px;
    height: 64%;
}

.threat-right {
    right: 0;
    top: 18%;
    width: 10px;
    height: 64%;
}

.threat-top {
    left: 18%;
    top: 0;
    width: 64%;
    height: 10px;
}

.threat-bottom {
    left: 18%;
    bottom: 0;
    width: 64%;
    height: 10px;
}

#hud-alerts {
    display: block;
    position: absolute;
    left: 50%;
    top: 74px;
    margin-left: -350px;
    width: 700px;
    pointer-events: none;
}

#threat-status {
    position: relative;
    width: 320px;
    margin-left: 190px;
    margin-top: 4px;
    display: none;
    text-align: center;
    font-size: 15px;
    font-weight: bold;
    color: #ff8a7a;
}

#siege-status {
    position: relative;
    width: 400px;
    margin-left: 150px;
    margin-top: 4px;
    display: none;
    text-align: center;
    font-size: 15px;
    font-weight: bold;
    color: #ffd479;
}

#siege-status.status-fail {
    color: #ff8a7a;
}

#base-status {
    position: relative;
    width: 560px;
    margin-left: 70px;
    display: none;
    text-align: center;
    font-size: 13px;
    line-height: 18px;
    font-weight: bold;
    color: #9fd7ff;
}

#base-status.status-warn {
    color: #ffd479;
}

#base-status.status-fail {
    color: #ff8a7a;
}

#mod-fields {
    position: relative;
    top: 0;
    right: 0;
    margin-top: 12px;
    margin-left: 50px;
    width: 260px;
    padding: 6px 10px;
    display: none;
}

.mod-fields-title {
    font-size: 11px;
    color: #9fb3c8;
}

.mod-field {
    display: none;
    margin-top: 3px;
    font-size: 11px;
    line-height: 15px;
}

.mod-field-label {
    color: #9fb3c8;
}

.mod-field-value {
    margin-left: 6px;
    color: #d7e2ec;
}

.mod-field.status-warn .mod-field-value {
    color: #ffd479;
}

.mod-field.status-ok .mod-field-value {
    color: #7fe08a;
}

.mod-field.status-fail .mod-field-value {
    color: #ff8a7a;
}

#hud-level {
    position: relative;
    left: 0;
    bottom: 0;
    width: 220px;
    padding: 7px 10px;
    margin-bottom: 8px;
}

.hud-level-row {
    height: 20px;
    line-height: 20px;
}

.level-text {
    display: inline-block;
    font-size: 15px;
    font-weight: bold;
    color: #ffffff;
    vertical-align: top;
}

.level-perk {
    display: none;
    float: right;
    margin-top: 1px;
    padding: 0 6px;
    background-color: #4a3b12;
    border-width: 1px;
    border-color: #b38a2e;
    border-radius: 8px;
    font-size: 11px;
    line-height: 16px;
    color: #ffd479;
}

.level-track {
    height: 6px;
    margin-top: 4px;
    background-color: #0b1117;
    border-width: 1px;
    border-color: #2c3e4f;
    border-radius: 3px;
}

.level-fill {
    width: 0%;
    height: 6px;
    border-radius: 3px;
    background-color: #4fb0ff;
}

.level-xp {
    margin-top: 2px;
    font-size: 11px;
    color: #9fb3c8;
}

.character-panel {
    position: absolute;
    left: 0px;
    top: 0px;
    width: 100%;
    height: 100%;
    display: none;
    background-color: #00000080;
}

.character-card {
    position: absolute;
    left: 50%;
    top: 50%;
    margin-left: -290px;
    margin-top: -240px;
    width: 580px;
    padding: 16px 20px;
}

.character-title {
    font-size: 18px;
    font-weight: bold;
    color: #ffffff;
}

.character-level {
    margin-top: 4px;
    font-size: 13px;
    color: #ffd479;
}

.character-section {
    margin-top: 12px;
    padding-top: 8px;
    border-top-width: 1px;
    border-color: #2c3e4f;
    font-size: 11px;
    color: #9fb3c8;
}

.character-skill {
    margin-top: 5px;
    font-size: 13px;
    line-height: 18px;
    color: #d7e2ec;
}

.character-perks {
    margin-top: 5px;
    font-size: 13px;
    line-height: 18px;
    color: #7fe08a;
}

.perk-choice {
    margin-top: 5px;
    font-size: 13px;
    line-height: 18px;
    color: #ffd479;
}

.character-hint {
    margin-top: 12px;
    font-size: 11px;
    color: #9fb3c8;
}

.perk-prompt {
    position: absolute;
    left: 50%;
    top: 200px;
    margin-left: -270px;
    width: 540px;
    display: none;
    padding: 6px 10px;
    text-align: center;
    font-size: 13px;
    line-height: 18px;
    font-weight: bold;
    color: #ffd479;
    background-color: #10161de8;
    border-width: 1px;
    border-color: #b38a2e;
    border-radius: 8px;
}

.siege-report {
    position: absolute;
    left: 0px;
    top: 0px;
    width: 100%;
    height: 100%;
    display: none;
    background-color: #00000080;
}

.siege-report-card {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 560px;
    margin-left: -280px;
    margin-top: -210px;
    padding: 18px 24px 16px 24px;
    background-color: #10161df2;
    border-width: 1px;
    border-color: #4d6a83;
    border-radius: 12px;
}

.siege-report-title {
    font-size: 20px;
    font-weight: bold;
    color: #ffffff;
}

.siege-report-rating {
    margin-top: 4px;
    font-size: 46px;
    line-height: 52px;
    font-weight: bold;
    color: #7fe08a;
}

.siege-report.status-warn .siege-report-rating {
    color: #ffd479;
}

.siege-report.status-fail .siege-report-rating {
    color: #ff8a7a;
}

.siege-report-line {
    margin-top: 5px;
    font-size: 14px;
    line-height: 20px;
    color: #d7e2ec;
}

.siege-report-hint {
    margin-top: 14px;
    padding-top: 10px;
    border-top-width: 1px;
    border-color: #2c3e4f;
    text-align: right;
    font-size: 11px;
    color: #9fb3c8;
}

#world-event-panel {
    position: absolute;
    left: 16px;
    top: 150px;
    width: 420px;
    display: none;
    z-index: 18;
    pointer-events: none;
}

.world-event-card {
    padding: 9px 13px 10px 13px;
    background-color: #10161df2;
    border-width: 1px;
    border-color: #5f4c33;
    border-left-width: 3px;
    border-radius: 10px;
}

.world-event-panel.status-warn .world-event-card {
    border-color: #9a7137;
}

.world-event-panel.status-ok .world-event-card {
    border-color: #3f7a50;
}

.world-event-panel.status-fail .world-event-card {
    border-color: #8a4a4a;
}

.world-event-header {
    height: 16px;
}

.world-event-kicker {
    display: inline-block;
    font-size: 10px;
    color: #ffb86b;
    letter-spacing: 1px;
}

.world-event-panel.status-ok .world-event-kicker {
    color: #7fe08a;
}

.world-event-panel.status-fail .world-event-kicker {
    color: #ff8a7a;
}

.world-event-meta {
    display: inline-block;
    margin-left: 8px;
    font-size: 10px;
    color: #9fb3c8;
}

.world-event-title {
    margin-top: 2px;
    font-size: 17px;
    font-weight: bold;
    line-height: 22px;
    color: #ffffff;
}

.world-event-stage {
    margin-top: 2px;
    font-size: 12px;
    line-height: 17px;
    color: #ffd479;
}

.world-event-result {
    display: none;
    margin-top: 5px;
    padding: 3px 7px;
    font-size: 12px;
    line-height: 17px;
    color: #7fe08a;
    background-color: #14251bcc;
    border-radius: 4px;
}

.world-event-result.status-fail {
    color: #ff8a7a;
    background-color: #2a1717cc;
}

.world-event-options {
    display: none;
    margin-top: 6px;
}

.world-event-option {
    display: none;
    margin-top: 3px;
    padding: 2px 7px;
    font-size: 12px;
    line-height: 17px;
    color: #c8d5e1;
    border-radius: 4px;
}

.world-event-option.active {
    background-color: #243444;
    color: #ffd479;
}

.world-event-hint {
    display: none;
    margin-top: 5px;
    font-size: 11px;
    line-height: 16px;
    color: #9fb3c8;
}

.world-event-log {
    display: none;
    margin-top: 7px;
    padding-top: 5px;
    border-top-width: 1px;
    border-color: #2c3e4f;
}

.world-event-log-title {
    font-size: 10px;
    color: #8ea4b4;
}

.world-event-log-line {
    display: none;
    margin-top: 2px;
    font-size: 10px;
    line-height: 14px;
    color: #aebdca;
}
