<rml>
<head>
    <title>ZomboidLike HUD</title>
    <link type="text/rcss" href="theme.rcss"/>
    <link type="text/rcss" href="hud.rcss"/>
</head>
<body>
    <div id="weather-overlay" class="weather-overlay weather-clear"></div>
    <div id="threat-left" class="threat-edge threat-left"></div>
    <div id="threat-right" class="threat-edge threat-right"></div>
    <div id="threat-top" class="threat-edge threat-top"></div>
    <div id="threat-bottom" class="threat-edge threat-bottom"></div>
    <div id="hud-alerts">
        <div id="base-status" class="base-status"></div>
        <div id="siege-status" class="siege-status"></div>
        <div id="companion-status" class="companion-status"></div>
        <div id="threat-status" class="threat-status"></div>
    </div>
    <div id="hud-clock" class="hud-box">
        <div id="hud-day" class="hud-day">第 1 天</div>
        <div class="hud-clock-row">
            <span id="hud-time" class="hud-time">07:30</span>
            <span id="hud-speed" class="hud-speed">1x</span>
        </div>
    </div>

    <div id="hud-right">
        <div id="hud-objective" class="hud-box">
            <div class="objective-label">目标</div>
            <div id="objective-text" class="objective-text">目标：--</div>
            <div id="objective-hint" class="objective-hint"></div>
            <div id="poi-guide" class="poi-guide"></div>
            <div id="poi-stage-panel" class="poi-stage-panel">
                <div id="poi-stage-title" class="poi-stage-title"></div>
                <div id="poi-stage-objective" class="poi-stage-objective"></div>
                <div id="poi-stage-meta" class="poi-stage-meta"></div>
                <div id="poi-stage-narrative" class="poi-stage-narrative"></div>
            </div>
            <div id="mission-guide" class="mission-guide"></div>
            <div id="event-guide" class="event-guide"></div>
            <div id="region-guide" class="region-guide"></div>
            <div id="settlement-guide" class="settlement-guide"></div>
            <div id="strategic-guide" class="strategic-guide"></div>
        </div>
        <div id="poi-result-panel" class="poi-result-panel">
            <div class="poi-result-kicker">POI</div>
            <div id="poi-result-title" class="poi-result-title"></div>
            <div id="poi-result-body" class="poi-result-body"></div>
        </div>
        <div id="mod-fields" class="mod-fields hud-box">
            <div class="mod-fields-title">模组</div>
            <div id="mod-field-0" class="mod-field">
                <span id="mod-field-label-0" class="mod-field-label"></span>
                <span id="mod-field-value-0" class="mod-field-value"></span>
            </div>
            <div id="mod-field-1" class="mod-field">
                <span id="mod-field-label-1" class="mod-field-label"></span>
                <span id="mod-field-value-1" class="mod-field-value"></span>
            </div>
            <div id="mod-field-2" class="mod-field">
                <span id="mod-field-label-2" class="mod-field-label"></span>
                <span id="mod-field-value-2" class="mod-field-value"></span>
            </div>
            <div id="mod-field-3" class="mod-field">
                <span id="mod-field-label-3" class="mod-field-label"></span>
                <span id="mod-field-value-3" class="mod-field-value"></span>
            </div>
            <div id="mod-field-4" class="mod-field">
                <span id="mod-field-label-4" class="mod-field-label"></span>
                <span id="mod-field-value-4" class="mod-field-value"></span>
            </div>
            <div id="mod-field-5" class="mod-field">
                <span id="mod-field-label-5" class="mod-field-label"></span>
                <span id="mod-field-value-5" class="mod-field-value"></span>
            </div>
            <div id="mod-field-6" class="mod-field">
                <span id="mod-field-label-6" class="mod-field-label"></span>
                <span id="mod-field-value-6" class="mod-field-value"></span>
            </div>
            <div id="mod-field-7" class="mod-field">
                <span id="mod-field-label-7" class="mod-field-label"></span>
                <span id="mod-field-value-7" class="mod-field-value"></span>
            </div>
        </div>
    </div>

    <div id="hud-left">
        <div id="hud-level" class="hud-box">
            <div class="hud-level-row">
                <span id="level-text" class="level-text">Lv.1</span>
                <span id="level-perk" class="level-perk">Perk×1</span>
            </div>
            <div class="level-track"><div id="level-fill" class="level-fill"></div></div>
            <div id="level-xp" class="level-xp">0 / 0</div>
        </div>
        <div id="hud-vitals" class="hud-box">
            <div class="vital-row">
                <span class="vital-label">生命</span>
                <div class="vital-track"><div id="hp-fill" class="vital-fill hp"></div></div>
                <span id="hp-text" class="vital-value">100</span>
            </div>
            <div class="vital-row">
                <span class="vital-label">体力</span>
                <div class="vital-track"><div id="stamina-fill" class="vital-fill stamina"></div></div>
                <span id="stamina-text" class="vital-value">100</span>
            </div>
            <div id="combat-status" class="needs-status combat-status"></div>
            <div id="stealth-status" class="needs-status stealth-status"></div>
            <div id="ranged-status" class="needs-status ranged-status"></div>
            <div id="throw-status" class="needs-status throw-status"></div>
            <div id="trap-status" class="needs-status trap-status"></div>
            <div id="forage-status" class="needs-status forage-status"></div>
            <div id="fishing-status" class="needs-status fishing-status"></div>
            <div id="needs-status" class="needs-status"></div>
            <div id="wound-status" class="needs-status wound-status"></div>
            <div id="pain-status" class="needs-status pain-status"></div>
            <div id="armor-status" class="needs-status armor-status"></div>
            <div id="infection-status" class="needs-status infection-status"></div>
            <div id="weather-status" class="needs-status weather-status"></div>
        </div>
    </div>

    <div id="hotbar">
        <div id="slot-0" class="slot selected">
            <div class="slot-key">1</div>
            <div id="slot-name-0" class="slot-name">空</div>
            <div id="slot-throw-0" class="slot-throw"></div>
            <div id="slot-count-0" class="slot-count"></div>
        </div>
        <div id="slot-1" class="slot">
            <div class="slot-key">2</div>
            <div id="slot-name-1" class="slot-name">空</div>
            <div id="slot-throw-1" class="slot-throw"></div>
            <div id="slot-count-1" class="slot-count"></div>
        </div>
        <div id="slot-2" class="slot">
            <div class="slot-key">3</div>
            <div id="slot-name-2" class="slot-name">空</div>
            <div id="slot-throw-2" class="slot-throw"></div>
            <div id="slot-count-2" class="slot-count"></div>
        </div>
        <div id="slot-3" class="slot">
            <div class="slot-key">4</div>
            <div id="slot-name-3" class="slot-name">空</div>
            <div id="slot-throw-3" class="slot-throw"></div>
            <div id="slot-count-3" class="slot-count"></div>
        </div>
        <div id="slot-4" class="slot">
            <div class="slot-key">5</div>
            <div id="slot-name-4" class="slot-name">空</div>
            <div id="slot-throw-4" class="slot-throw"></div>
            <div id="slot-count-4" class="slot-count"></div>
        </div>
    </div>

    <div id="hud-bag" class="hud-bag">
        <span class="hud-bag-label">背包</span>
        <span class="hud-bag-key">I</span>
    </div>

    <div id="action-hint" class="action-hint"></div>
    <div id="stealth-prompt" class="stealth-prompt"></div>

    <div id="dialogue-panel" class="dialogue-panel">
        <div class="dialogue-card">
            <div id="dialogue-speaker" class="dialogue-speaker"></div>
            <div id="dialogue-text" class="dialogue-text"></div>
            <div id="dialogue-option-0" class="dialogue-option"></div>
            <div id="dialogue-option-1" class="dialogue-option"></div>
            <div id="dialogue-option-2" class="dialogue-option"></div>
            <div id="dialogue-option-3" class="dialogue-option"></div>
            <div id="dialogue-option-4" class="dialogue-option"></div>
            <div id="dialogue-hint" class="dialogue-hint">1-5 选择 · 滚轮定位 · E 确认 · ESC 关闭</div>
        </div>
    </div>

    <div id="character-panel" class="character-panel">
        <div class="character-card hud-box">
            <div class="character-title">角色面板</div>
            <div id="character-level" class="character-level">等级 1</div>
            <div class="level-track"><div id="character-xp-fill" class="level-fill"></div></div>
            <div id="character-xp" class="level-xp">0 / 0 XP</div>
            <div class="character-section">技能</div>
            <div id="character-skill-0" class="character-skill"></div>
            <div id="character-skill-1" class="character-skill"></div>
            <div id="character-skill-2" class="character-skill"></div>
            <div id="character-skill-3" class="character-skill"></div>
            <div class="character-section">已选 Perk</div>
            <div id="character-perks" class="character-perks">暂无</div>
            <div class="character-section">升级选择</div>
            <div id="perk-choice-0" class="perk-choice"></div>
            <div id="perk-choice-1" class="perk-choice"></div>
            <div id="perk-choice-2" class="perk-choice"></div>
            <div class="character-hint">1/2/3 选择 Perk · C/ESC 关闭</div>
        </div>
    </div>
    <div id="companion-panel" class="companion-panel">
        <div class="companion-card hud-box">
            <div class="companion-title">同伴</div>
            <div id="companion-name" class="companion-name"></div>
            <div id="companion-health" class="companion-health"></div>
            <div class="companion-track"><div id="companion-health-fill" class="companion-health-fill"></div></div>
            <div id="companion-state" class="companion-state"></div>
            <div id="companion-trust" class="companion-trust"></div>
            <div class="companion-section">装备</div>
            <div id="companion-equipment" class="companion-line"></div>
            <div class="companion-section">背包</div>
            <div id="companion-bag" class="companion-line"></div>
            <div class="companion-section">个人委托</div>
            <div id="companion-quest" class="companion-line"></div>
            <div id="companion-hint" class="companion-hint">1 跟随 · 2 停留 · 3 撤退 · 4 赠礼 · E 交谈/救援 · P/ESC 关闭</div>
        </div>
    </div>
    <div id="perk-prompt" class="perk-prompt"></div>
    <div id="siege-report" class="siege-report">
        <div id="siege-report-card" class="siege-report-card">
            <div id="siege-report-title" class="siege-report-title">守夜战报</div>
            <div id="siege-report-rating" class="siege-report-rating">S</div>
            <div id="siege-report-line-0" class="siege-report-line"></div>
            <div id="siege-report-line-1" class="siege-report-line"></div>
            <div id="siege-report-line-2" class="siege-report-line"></div>
            <div id="siege-report-line-3" class="siege-report-line"></div>
            <div id="siege-report-line-4" class="siege-report-line"></div>
            <div id="siege-report-line-5" class="siege-report-line"></div>
            <div id="siege-report-line-6" class="siege-report-line"></div>
            <div id="siege-report-line-7" class="siege-report-line"></div>
            <div id="siege-report-hint" class="siege-report-hint">ESC 关闭</div>
        </div>
    </div>
    <div id="world-event-panel" class="world-event-panel">
        <div class="world-event-card">
            <div class="world-event-header">
                <span class="world-event-kicker">世界事件</span>
                <span id="world-event-meta" class="world-event-meta"></span>
            </div>
            <div id="world-event-title" class="world-event-title"></div>
            <div id="world-event-stage" class="world-event-stage"></div>
            <div id="world-event-result" class="world-event-result"></div>
            <div id="world-event-options" class="world-event-options">
                <div id="world-event-option-0" class="world-event-option"></div>
                <div id="world-event-option-1" class="world-event-option"></div>
                <div id="world-event-option-2" class="world-event-option"></div>
                <div id="world-event-option-3" class="world-event-option"></div>
                <div id="world-event-option-4" class="world-event-option"></div>
                <div id="world-event-option-5" class="world-event-option"></div>
                <div id="world-event-option-6" class="world-event-option"></div>
                <div id="world-event-option-7" class="world-event-option"></div>
            </div>
            <div id="world-event-hint" class="world-event-hint"></div>
            <div id="world-event-log" class="world-event-log">
                <div class="world-event-log-title">电台记录</div>
                <div id="world-event-log-0" class="world-event-log-line"></div>
                <div id="world-event-log-1" class="world-event-log-line"></div>
                <div id="world-event-log-2" class="world-event-log-line"></div>
                <div id="world-event-log-3" class="world-event-log-line"></div>
                <div id="world-event-log-4" class="world-event-log-line"></div>
                <div id="world-event-log-5" class="world-event-log-line"></div>
            </div>
        </div>
    </div>
    <div id="notice" class="notice notice-info"></div>
</body>
</rml>
