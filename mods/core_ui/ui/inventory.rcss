body {
    font-family: zl_ui;
    font-size: 13px;
    color: #e6edf3;
    width: 100%;
    height: 100%;
}

#inventory-overlay {
    position: absolute;
    left: 0px;
    top: 0px;
    width: 100%;
    height: 100%;
    background-color: #00000099;
}

#inventory-panel {
    position: absolute;
    left: 50%;
    top: 50%;
    margin-left: -370px;
    margin-top: -280px;
    width: 740px;
    height: 560px;
    padding: 16px 20px;
    background-color: #10161df7;
    border-width: 1px;
    border-color: #3d566d;
    border-radius: 14px;
}

.inv-header {
    height: 38px;
}

.inv-title {
    display: inline-block;
    font-size: 22px;
    line-height: 38px;
    color: #ffd479;
    font-weight: bold;
    vertical-align: top;
}

.inv-weight {
    display: inline-block;
    margin-left: 14px;
    line-height: 38px;
    font-size: 13px;
    color: #9fb3c8;
    vertical-align: top;
}

.inv-close {
    position: absolute;
    right: 14px;
    top: 12px;
    width: 30px;
    height: 30px;
    line-height: 30px;
    text-align: center;
    font-size: 15px;
    color: #c9d6e2;
    background-color: #243444;
    border-width: 1px;
    border-color: #3d566d;
    border-radius: 6px;
    cursor: pointer;
}

.inv-close:hover {
    background-color: #4a2b2b;
    border-color: #8a4a4a;
    color: #ff9a8a;
}

.inv-columns {
    margin-top: 4px;
}

.inv-column-left {
    display: inline-block;
    width: 380px;
    vertical-align: top;
}

.inv-column-right {
    display: inline-block;
    width: 300px;
    margin-left: 16px;
    vertical-align: top;
}

.inv-section-title {
    height: 24px;
    line-height: 24px;
    font-size: 13px;
    color: #9fb3c8;
}

.inv-count-label {
    margin-left: 6px;
    font-size: 11px;
    color: #7f93a6;
}

.craft-page-btn {
    display: inline-block;
    width: 16px;
    height: 18px;
    line-height: 18px;
    margin-left: 3px;
    text-align: center;
    font-size: 12px;
    color: #d7e2ec;
    background-color: #1b2a38;
    border-width: 1px;
    border-color: #3a5266;
    border-radius: 4px;
    cursor: pointer;
    vertical-align: top;
}

.craft-page-btn:hover {
    background-color: #2b4257;
    color: #ffffff;
}

.craft-page-btn.disabled {
    color: #637585;
    background-color: #121c25;
    border-color: #263440;
    cursor: default;
}

.craft-page-indicator {
    display: inline-block;
    margin-left: 4px;
    font-size: 11px;
    color: #7f93a6;
}

.craft-toolbar {
    position: relative;
    width: 296px;
    height: 24px;
}

.craft-qty {
    position: absolute;
    right: 0;
    top: 1px;
    width: 112px;
    height: 22px;
}

.craft-qty-label {
    position: absolute;
    left: 0;
    top: 3px;
    height: 16px;
    line-height: 16px;
    font-size: 11px;
    color: #8fa4b8;
}

.craft-qty-btn,
.craft-qty-value {
    position: absolute;
    top: 2px;
    height: 18px;
    line-height: 18px;
    text-align: center;
    font-size: 11px;
    color: #d7e2ec;
    background-color: #1b2a38;
    border-width: 1px;
    border-color: #3a5266;
    border-radius: 4px;
    cursor: pointer;
}

.craft-qty-btn {
    width: 18px;
}

#craft-qty-minus {
    left: 30px;
}

#craft-qty-value {
    left: 51px;
    width: 28px;
    color: #ffd479;
    cursor: default;
}

#craft-qty-plus {
    left: 82px;
}

.craft-qty-btn:hover {
    background-color: #2b4257;
    color: #ffffff;
}

.craft-qty-btn.disabled {
    color: #637585;
    background-color: #121c25;
    border-color: #263440;
    cursor: default;
}

.equip-row {
    height: 70px;
}

.inv-grid {
    width: 380px;
}

.loot-grid {
    width: 300px;
}

.inv-slot {
    display: inline-block;
    position: relative;
    width: 64px;
    height: 64px;
    margin-right: 4px;
    margin-bottom: 4px;
    background-color: #0b1117;
    border-width: 1px;
    border-color: #263440;
    border-radius: 8px;
    vertical-align: top;
}

.inv-slot.filled {
    background-color: #1a2834;
    border-color: #4a6a84;
    cursor: pointer;
    drag: clone;
}

.inv-slot.filled:hover {
    border-color: #ffd479;
    background-color: #243444;
}

.inv-slot.drop-target {
    border-color: #7fe08a;
    background-color: #1f3a2b;
}

.inv-slot.is-dragging {
    opacity: 0.45;
}

.equip-slot {
    width: 88px;
    height: 64px;
    background-color: #0e1820;
    border-color: #34495c;
}

.inv-kind {
    position: absolute;
    left: 5px;
    top: 2px;
    font-size: 11px;
    color: #9fb3c8;
}

.inv-name {
    position: absolute;
    left: 4px;
    right: 4px;
    top: 18px;
    height: 34px;
    line-height: 16px;
    font-size: 11px;
    text-align: center;
    color: #d7e2ec;
    overflow: hidden;
    word-break: break-word;
}

.inv-slot.filled .inv-name {
    color: #ffffff;
}

.inv-count {
    position: absolute;
    right: 5px;
    bottom: 2px;
    font-size: 11px;
    color: #ffd479;
}

.craft-list {
    width: 296px;
    margin-top: 2px;
}

.craft-row {
    position: relative;
    width: 296px;
    height: 38px;
    margin-bottom: 4px;
    background-color: #0e1820;
    border-width: 1px;
    border-color: #263440;
    border-radius: 6px;
}

.craft-row.craftable {
    border-color: #3f6a4a;
    background-color: #12211a;
}

.craft-row.busy {
    border-color: #a8843f;
    background-color: #2a2414;
}

.craft-row.locked {
    border-color: #3a3f48;
    background-color: #11161c;
}

.craft-row.locked .craft-name {
    color: #8d97a3;
}

.craft-name {
    position: absolute;
    left: 8px;
    top: 3px;
    width: 182px;
    height: 15px;
    line-height: 15px;
    font-size: 11px;
    color: #d7e2ec;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
}

.craft-ing {
    position: absolute;
    left: 8px;
    top: 18px;
    width: 182px;
    height: 14px;
    line-height: 14px;
    font-size: 11px;
    color: #8fa4b8;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
}

.craft-state {
    position: absolute;
    right: 48px;
    top: 11px;
    width: 48px;
    height: 16px;
    line-height: 16px;
    font-size: 11px;
    text-align: right;
    color: #ff9a8a;
}

.craft-state.ok {
    color: #7fe08a;
}

.craft-state.busy {
    color: #ffd479;
}

.craft-btn {
    position: absolute;
    right: 6px;
    top: 8px;
    width: 38px;
    height: 22px;
    line-height: 22px;
    text-align: center;
    font-size: 11px;
    color: #d7e2ec;
    background-color: #2f6f9f;
    border-width: 1px;
    border-color: #52708b;
    border-radius: 5px;
    cursor: pointer;
}

.craft-btn:hover {
    background-color: #3f86bb;
    color: #ffffff;
}

.craft-btn.disabled {
    color: #637585;
    background-color: #17222c;
    border-color: #2d3c4a;
    cursor: default;
}

.craft-progress {
    display: none;
    position: relative;
    width: 296px;
    height: 64px;
    margin-top: 4px;
    background-color: #0e1820;
    border-width: 1px;
    border-color: #4a6a84;
    border-radius: 6px;
}

.craft-progress-label {
    position: absolute;
    left: 8px;
    top: 3px;
    width: 140px;
    height: 16px;
    line-height: 16px;
    font-size: 11px;
    color: #ffd479;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
}

.craft-progress-time {
    position: absolute;
    left: 150px;
    top: 3px;
    width: 88px;
    height: 16px;
    line-height: 16px;
    font-size: 10px;
    text-align: right;
    color: #8fa4b8;
}

.craft-cancel {
    position: absolute;
    right: 6px;
    top: 3px;
    width: 48px;
    height: 18px;
    line-height: 18px;
    text-align: center;
    font-size: 10px;
    color: #ffb3a7;
    background-color: #2a1b1b;
    border-width: 1px;
    border-color: #733b3b;
    border-radius: 4px;
    cursor: pointer;
}

.craft-cancel:hover {
    background-color: #4a2929;
    border-color: #a85454;
    color: #ffffff;
}

.craft-progress-track {
    position: absolute;
    left: 8px;
    right: 8px;
    top: 25px;
    height: 8px;
    background-color: #17222c;
    border-radius: 4px;
    overflow: hidden;
}

.craft-progress-fill {
    width: 0%;
    height: 8px;
    background-color: #7fe08a;
    border-radius: 4px;
}

.craft-queue-row {
    position: absolute;
    left: 8px;
    right: 8px;
    top: 38px;
    height: 18px;
}

.craft-queue-label {
    position: absolute;
    left: 20px;
    right: 102px;
    top: 0;
    height: 18px;
    line-height: 18px;
    font-size: 10px;
    color: #8fa4b8;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
}

.craft-queue-btn {
    position: absolute;
    top: 0;
    width: 16px;
    height: 18px;
    line-height: 18px;
    text-align: center;
    font-size: 10px;
    color: #c9d6e2;
    background-color: #1b2a38;
    border-width: 1px;
    border-color: #3a5266;
    border-radius: 3px;
    cursor: pointer;
}

.craft-queue-btn:hover {
    background-color: #2b4257;
    color: #ffffff;
}

.craft-queue-btn.disabled {
    color: #637585;
    background-color: #121c25;
    border-color: #263440;
    cursor: default;
}

#craft-queue-prev {
    left: 0;
}

#craft-queue-next {
    right: 85px;
}

#craft-queue-up {
    right: 68px;
}

#craft-queue-down {
    right: 51px;
}

#craft-queue-dec {
    right: 34px;
}

#craft-queue-inc {
    right: 17px;
}

#craft-queue-remove {
    right: 0;
    color: #ffb3a7;
    background-color: #2a1b1b;
    border-color: #733b3b;
}

#craft-queue-remove:hover {
    background-color: #4a2929;
    border-color: #a85454;
    color: #ffffff;
}

#craft-queue-remove.disabled {
    color: #637585;
    background-color: #121c25;
    border-color: #263440;
}

.inv-hint {
    margin-top: 6px;
    width: 286px;
    font-size: 11px;
    line-height: 1.4;
    color: #8fa4b8;
    word-break: break-word;
}

.inv-status {
    margin-top: 4px;
    width: 286px;
    min-height: 20px;
    font-size: 13px;
    line-height: 1.5;
    color: #ffd479;
    word-break: break-word;
}

.inv-status.status-ok {
    color: #7fe08a;
}

.inv-status.status-fail {
    color: #ff8a7a;
}

.context-menu {
    position: absolute;
    display: none;
    width: 128px;
    padding: 4px;
    background-color: #16202af7;
    border-width: 1px;
    border-color: #52708b;
    border-radius: 8px;
}

.ctx-btn {
    height: 28px;
    line-height: 28px;
    padding-left: 10px;
    font-size: 13px;
    color: #d7e2ec;
    border-radius: 5px;
    cursor: pointer;
}

.ctx-btn:hover {
    background-color: #2f6f9f;
    color: #ffffff;
}
