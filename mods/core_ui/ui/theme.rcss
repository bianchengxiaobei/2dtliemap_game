@spritesheet ui_theme
{
    src: ui_theme.png;
    panel: 0px 0px 32px 32px;
    panel-inner: 10px 10px 12px 12px;
}

div {
    display: block;
}

body {
    font-family: zl_ui;
    font-size: 15px;
    color: #e6edf3;
    width: 100%;
    height: 100%;
}

.panel {
    background-color: #10161df2;
    border-width: 1px;
    border-color: #34495c;
    border-radius: 14px;
}

.card {
    background-color: #16202a;
    border-width: 1px;
    border-color: #2c3e4f;
    border-radius: 10px;
    padding: 10px 12px;
    margin-top: 10px;
}

.section-title {
    font-size: 13px;
    color: #9fb3c8;
    margin-bottom: 6px;
}

.title {
    font-size: 22px;
    color: #ffd479;
}

.muted {
    color: #8fa4b8;
    font-size: 13px;
}

.label {
    color: #d7e2ec;
    font-size: 15px;
}

.text-xs {
    font-size: 11px;
    line-height: 1.5;
}

.text-sm {
    font-size: 13px;
    line-height: 1.55;
}

.text-base {
    font-size: 15px;
    line-height: 1.6;
}

.text-lg {
    font-size: 18px;
    line-height: 1.5;
}

.text-xl {
    font-size: 22px;
    line-height: 1.35;
}

b,
strong,
.weight-bold {
    font-weight: bold;
}

.weight-regular {
    font-weight: normal;
}

.wrap-demo {
    width: 100%;
    line-height: 1.5;
    word-break: break-word;
}

.ellipsis {
    width: 100%;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.rich-accent {
    color: #ffd479;
}

.rich-danger {
    color: #ff8a7a;
}

#atlas-stats {
    margin-top: 4px;
}

#atlas-stats.over-budget {
    color: #ff8a7a;
}

.row {
    height: 34px;
}

.btn {
    display: inline-block;
    height: 32px;
    line-height: 32px;
    padding: 0 12px;
    background-color: #243444;
    border-width: 1px;
    border-color: #3d566d;
    border-radius: 6px;
    color: #e6edf3;
    font-size: 15px;
    text-align: center;
    cursor: pointer;
}

.btn:hover {
    background-color: #30475c;
    border-color: #52708b;
}

.btn:active {
    background-color: #1b2b39;
}

.btn:focus-visible {
    border-color: #ffd479;
    color: #ffe6a8;
}

.btn:disabled {
    background-color: #172129;
    border-color: #263440;
    color: #5f7385;
}

.btn.primary {
    background-color: #2f6f9f;
    border-color: #5798c8;
    color: #ffffff;
}

.btn.primary:hover {
    background-color: #3c86bb;
}

.btn.primary:active {
    background-color: #255a80;
}

input {
    height: 32px;
    padding: 0 10px;
    background-color: #0b1117;
    border-width: 1px;
    border-color: #34495c;
    border-radius: 6px;
    color: #ffffff;
    font-size: 15px;
}

input:focus-visible {
    border-color: #ffd479;
}

input.range {
    width: 196px;
    height: 28px;
    padding: 0;
    background-color: transparent;
    border-width: 0;
    border-radius: 0;
}

input.range slidertrack {
    height: 6px;
    margin-top: 11px;
    background-color: #0b1117;
    border-radius: 3px;
}

input.range sliderprogress {
    height: 6px;
    margin-top: 11px;
    background-color: #5798c8;
    border-radius: 3px;
}

input.range sliderbar {
    width: 14px;
    height: 20px;
    margin-top: 4px;
    background-color: #e6edf3;
    border-width: 1px;
    border-color: #8fb7d4;
    border-radius: 7px;
}

input.range sliderarrowdec,
input.range sliderarrowinc {
    display: none;
}

#scroll {
    height: 132px;
    overflow-y: scroll;
    background-color: #00000040;
    border-width: 1px;
    border-color: #2c3e4f;
    border-radius: 8px;
}

.item {
    padding: 5px 10px;
    border-bottom-width: 1px;
    border-bottom-color: #24313d;
    font-size: 13px;
    color: #c9d6e2;
}

.item:hover {
    background-color: #22303d;
}

scrollbarvertical {
    width: 10px;
    margin-right: 0px;
}

scrollbarvertical slidertrack {
    height: 100%;
    margin-top: 0px;
    background-color: #1b2530;
    border-radius: 0px;
}

scrollbarvertical sliderbar {
    width: 8px;
    height: 40px;
    margin-top: 0px;
    background-color: #4a637a;
    border-width: 0;
    border-radius: 4px;
}

#ninepatch-demo {
    height: 48px;
    line-height: 48px;
    padding: 0 12px;
    decorator: ninepatch(panel, panel-inner, 1.0) border-box;
    font-size: 13px;
    color: #cfe0ee;
}
