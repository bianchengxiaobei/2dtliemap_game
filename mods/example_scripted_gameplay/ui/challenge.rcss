body {
  font-family: zl_ui;
  font-size: 12px;
  color: #e6edf3;
  width: 100%;
  height: 100%;
  pointer-events: none;
}

.challenge-panel,
.challenge-header,
.challenge-state,
.challenge-row,
.challenge-cell,
.challenge-label,
.challenge-value,
.challenge-bar,
.challenge-fill,
.challenge-objective-label,
.challenge-objective,
.challenge-hint {
  display: block;
}

.challenge-panel {
  position: absolute;
  left: 16px;
  top: 16px;
  width: 244px;
  padding: 10px;
  background-color: #10161de8;
  border-width: 1px;
  border-color: #34495c;
  border-left-width: 3px;
  border-left-color: #ffd479;
  border-radius: 10px;
  pointer-events: none;
}

.challenge-header {
  height: 20px;
}

.challenge-kicker {
  display: inline-block;
  margin-top: 2px;
  font-size: 10px;
  color: #ffd479;
  letter-spacing: 1px;
}

.challenge-hide {
  position: absolute;
  right: 8px;
  top: 8px;
  padding: 2px 8px;
  background-color: #243444;
  border-width: 1px;
  border-color: #3d566d;
  border-radius: 6px;
  color: #9fb3c8;
  pointer-events: auto;
}

.challenge-hide:hover {
  background-color: #33506a;
  color: #ffffff;
}

.challenge-state {
  margin-top: 4px;
  font-size: 17px;
  font-weight: bold;
  color: #ffd479;
}

.challenge-row {
  margin-top: 7px;
}

.challenge-cell {
  display: inline-block;
  width: 110px;
  vertical-align: top;
}

.challenge-label {
  font-size: 10px;
  color: #9fb3c8;
}

.challenge-value {
  margin-top: 1px;
  font-size: 14px;
  font-weight: bold;
  color: #ffffff;
}

.challenge-best {
  color: #7fe08a;
}

.challenge-bar {
  height: 5px;
  margin-top: 9px;
  background-color: #0b1117;
  border-width: 1px;
  border-color: #2c3e4f;
  border-radius: 3px;
}

.challenge-fill {
  width: 0%;
  height: 5px;
  background-color: #ffd479;
  border-radius: 3px;
}

.challenge-objective-label {
  margin-top: 9px;
  font-size: 10px;
  color: #9fb3c8;
}

.challenge-objective {
  margin-top: 2px;
  font-size: 12px;
  line-height: 17px;
  color: #d7e2ec;
}

.challenge-hint {
  margin-top: 6px;
  font-size: 10px;
  line-height: 14px;
  color: #6f8498;
}
