body {
    font-family: zl_ui;
    font-size: 13px;
    color: #e6edf3;
    width: 100%;
    height: 100%;
}

#inventory-overlay {
    position: absolute;
    left: 0px;
    top: 0px;
    width: 100%;
    height: 100%;
    background-color: #00000099;
}

#inventory-panel {
    position: absolute;
    left: 50%;
    top: 50%;
    margin-left: -370px;
    margin-top: -280px;
    width: 740px;
    height: 560px;
    padding: 16px 20px;
    background-color: #10161df7;
    border-width: 1px;
    border-color: #3d566d;
    border-radius: 14px;
}

.inv-header {
    height: 38px;
}

.inv-title {
    display: inline-block;
    font-size: 22px;
    line-height: 38px;
    color: #ffd479;
    font-weight: bold;
    vertical-align: top;
}

.inv-weight {
    display: inline-block;
    margin-left: 14px;
    line-height: 38px;
    font-size: 13px;
    color: #9fb3c8;
    vertical-align: top;
}

.inv-close {
    position: absolute;
    right: 14px;
    top: 12px;
    width: 30px;
    height: 30px;
    line-height: 30px;
    text-align: center;
    font-size: 15px;
    color: #c9d6e2;
    background-color: #243444;
    border-width: 1px;
    border-color: #3d566d;
    border-radius: 6px;
    cursor: pointer;
}

.inv-close:hover {
    background-color: #4a2b2b;
    border-color: #8a4a4a;
    color: #ff9a8a;
}

.inv-columns {
    margin-top: 4px;
}

.inv-column-left {
    display: inline-block;
    width: 380px;
    vertical-align: top;
}

.inv-column-right {
    display: inline-block;
    width: 300px;
    margin-left: 16px;
    vertical-align: top;
}

.inv-section-title {
    height: 24px;
    line-height: 24px;
    font-size: 13px;
    color: #9fb3c8;
}

.inv-count-label {
    margin-left: 6px;
    font-size: 11px;
    color: #7f93a6;
}

.equip-row {
    height: 70px;
}

.inv-grid {
    width: 380px;
}

.loot-grid {
    width: 300px;
}

.inv-slot {
    display: inline-block;
    position: relative;
    width: 64px;
    height: 64px;
    margin-right: 4px;
    margin-bottom: 4px;
    background-color: #0b1117;
    border-width: 1px;
    border-color: #263440;
    border-radius: 8px;
    vertical-align: top;
}

.inv-slot.filled {
    background-color: #1a2834;
    border-color: #4a6a84;
    cursor: pointer;
    drag: clone;
}

.inv-slot.filled:hover {
    border-color: #ffd479;
    background-color: #243444;
}

.inv-slot.drop-target {
    border-color: #7fe08a;
    background-color: #1f3a2b;
}

.inv-slot.is-dragging {
    opacity: 0.45;
}

.equip-slot {
    width: 88px;
    height: 64px;
    background-color: #0e1820;
    border-color: #34495c;
}

.inv-kind {
    position: absolute;
    left: 5px;
    top: 2px;
    font-size: 11px;
    color: #9fb3c8;
}

.inv-name {
    position: absolute;
    left: 4px;
    right: 4px;
    top: 18px;
    height: 34px;
    line-height: 16px;
    font-size: 11px;
    text-align: center;
    color: #d7e2ec;
    overflow: hidden;
    word-break: break-word;
}

.inv-slot.filled .inv-name {
    color: #ffffff;
}

.inv-count {
    position: absolute;
    right: 5px;
    bottom: 2px;
    font-size: 11px;
    color: #ffd479;
}

.storage-actions {
    display: none;
    margin-top: 8px;
    width: 300px;
    height: 26px;
}

.storage-btn {
    display: inline-block;
    width: 92px;
    height: 24px;
    line-height: 24px;
    margin-right: 8px;
    text-align: center;
    font-size: 12px;
    color: #d7e2ec;
    background-color: #16222c;
    border-width: 1px;
    border-color: #34495c;
    border-radius: 3px;
}

.storage-btn:hover {
    color: #ffd479;
    border-color: #ffd479;
}

.inv-hint {
    margin-top: 12px;
    width: 286px;
    font-size: 11px;
    line-height: 1.6;
    color: #8fa4b8;
    word-break: break-word;
}

.inv-status {
    margin-top: 10px;
    width: 286px;
    min-height: 20px;
    font-size: 13px;
    line-height: 1.5;
    color: #ffd479;
    word-break: break-word;
}

.inv-status.status-ok {
    color: #7fe08a;
}

.inv-status.status-fail {
    color: #ff8a7a;
}

.context-menu {
    position: absolute;
    display: none;
    width: 128px;
    padding: 4px;
    background-color: #16202af7;
    border-width: 1px;
    border-color: #52708b;
    border-radius: 8px;
}

.ctx-btn {
    height: 28px;
    line-height: 28px;
    padding-left: 10px;
    font-size: 13px;
    color: #d7e2ec;
    border-radius: 5px;
    cursor: pointer;
}

.ctx-btn:hover {
    background-color: #2f6f9f;
    color: #ffffff;
}
