#type-panel {
    position: absolute;
    left: 16px;
    top: 400px;
    width: 840px;
    padding: 10px 14px 8px 14px;
}

#type-panel .title {
    margin-bottom: 2px;
}

#type-panel .muted {
    margin-bottom: 4px;
}

.type-col {
    display: inline-block;
    width: 260px;
    margin-right: 10px;
    vertical-align: top;
}

.type-col:last-child {
    margin-right: 0px;
}

.weight-line {
    margin-top: 8px;
    font-size: 13px;
}

.weight-line span,
.weight-line b {
    margin-right: 8px;
}

.ellipsis-title,
.atlas-title {
    margin-top: 8px;
}

.rich-line {
    line-height: 1.7;
}

#panel {
    position: absolute;
    right: 16px;
    top: 16px;
    width: 388px;
    padding: 16px;
}

#badge {
    position: absolute;
    right: 16px;
    top: 16px;
    padding: 3px 8px;
    background-color: #243444;
    border-width: 1px;
    border-color: #3d566d;
    border-radius: 9px;
    font-size: 11px;
    color: #9fb3c8;
}

#title {
    margin-bottom: 2px;
}

#subtitle {
    margin-bottom: 4px;
}

#count {
    display: inline-block;
    width: 64px;
    height: 32px;
    line-height: 32px;
    text-align: center;
    font-size: 18px;
    color: #ffffff;
}

#dec,
#inc {
    width: 34px;
    padding: 0;
    font-size: 18px;
}

.hint-inline {
    display: inline-block;
    margin-left: 10px;
    font-size: 12px;
    color: #7f93a6;
}

.buttons-row {
    margin-top: 10px;
}

.buttons-row .btn {
    margin-right: 8px;
}

.image-row {
    height: 52px;
    margin-bottom: 10px;
}

#demo-image {
    display: inline-block;
    width: 48px;
    height: 48px;
    margin-right: 10px;
    vertical-align: top;
}

.image-meta {
    display: inline-block;
    vertical-align: top;
}

#name {
    width: 330px;
}

.slider-row {
    margin-top: 10px;
}

.slider-label {
    display: inline-block;
    width: 42px;
    line-height: 28px;
    vertical-align: top;
}

#volume {
    display: inline-block;
    vertical-align: top;
}

#volume-value {
    display: inline-block;
    width: 34px;
    line-height: 28px;
    text-align: right;
    color: #9fb3c8;
    vertical-align: top;
}

.list-title {
    margin-top: 12px;
}

#hint {
    margin-top: 8px;
    font-size: 11px;
    color: #7f93a6;
}
