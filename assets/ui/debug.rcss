div {
    display: block;
}

body {
    font-family: zl_ui;
    font-size: 16px;
    color: #e6edf3;
    width: 100%;
    height: 100%;
}

#panel {
    position: absolute;
    left: 850px;
    top: 24px;
    width: 380px;
    padding: 14px 16px 16px 16px;
    background-color: #12181eeb;
    border-width: 1px;
    border-color: #3a4d5e;
}

#title {
    font-size: 20px;
    color: #ffd479;
    margin-bottom: 4px;
}

#subtitle {
    font-size: 13px;
    color: #9fb3c8;
    margin-bottom: 12px;
}

.row {
    height: 36px;
    margin: 4px 0 8px 0;
}

.btn {
    display: inline-block;
    width: 36px;
    height: 34px;
    line-height: 34px;
    text-align: center;
    background-color: #2b3a49;
    color: #ffffff;
    font-size: 18px;
}

.btn:hover {
    background-color: #3d5468;
}

.btn:active {
    background-color: #5a7893;
}

#count {
    display: inline-block;
    width: 72px;
    height: 34px;
    line-height: 34px;
    text-align: center;
    font-size: 18px;
    color: #ffffff;
}

input {
    width: 330px;
    height: 30px;
    padding: 0 10px;
    background-color: #0e151c;
    border-width: 1px;
    border-color: #3a4d5e;
    color: #ffffff;
    font-size: 15px;
}

#scroll {
    width: 100%;
    height: 150px;
    overflow-y: scroll;
    margin-top: 12px;
    background-color: #00000040;
}

.item {
    padding: 5px 10px;
    border-bottom-width: 1px;
    border-bottom-color: #24313d;
    font-size: 14px;
    color: #c9d6e2;
}

#hint {
    margin-top: 10px;
    font-size: 12px;
    color: #7f93a6;
}

scrollbarvertical {
    width: 10px;
    margin-right: 0px;
}

scrollbarvertical slidertrack {
    background-color: #1b2530;
}

scrollbarvertical sliderbar {
    width: 8px;
    background-color: #4a637a;
}
