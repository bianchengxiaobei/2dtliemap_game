body {
    font-family: zl_ui;
    font-size: 13px;
    color: #e6edf3;
    width: 100%;
    height: 100%;
}

#vehicle-mods-overlay {
    position: absolute;
    left: 0px;
    top: 0px;
    width: 100%;
    height: 100%;
    display: none;
    background-color: #030609b8;
    z-index: 90;
}

.vm-panel {
    position: absolute;
    left: 50%;
    top: 50%;
    margin-left: -380px;
    margin-top: -300px;
    width: 760px;
    height: 600px;
    padding: 16px 20px;
    border-width: 1px;
    border-color: #53657a;
    border-radius: 10px;
    background-color: #111820f7;
}

.vm-header {
    height: 38px;
}

.vm-title {
    display: inline-block;
    font-size: 22px;
    line-height: 38px;
    font-weight: bold;
    color: #ffd479;
    vertical-align: top;
}

.vm-subtitle {
    display: inline-block;
    margin-left: 14px;
    line-height: 38px;
    color: #9fb1c4;
    vertical-align: top;
}

.vm-close {
    position: absolute;
    right: 16px;
    top: 12px;
    width: 30px;
    height: 30px;
    line-height: 30px;
    text-align: center;
    border-width: 1px;
    border-color: #3d566d;
    border-radius: 6px;
    background-color: #243444;
    color: #c9d6e2;
    cursor: pointer;
}

.vm-close:hover {
    background-color: #4a2b2b;
    border-color: #8a4a4a;
    color: #ff9a8a;
}

.vm-status {
    height: 22px;
    line-height: 22px;
    color: #d7e3ef;
}

.vm-summary {
    min-height: 20px;
    margin-bottom: 2px;
    line-height: 20px;
    color: #ffd479;
    font-size: 12px;
    word-break: break-word;
}

.vm-progress {
    width: 100%;
    height: 7px;
    margin-top: 2px;
    margin-bottom: 8px;
    border-radius: 3px;
    background-color: #27323e;
    display: none;
    overflow: hidden;
}

.vm-progress-fill {
    width: 0%;
    height: 100%;
    background-color: #c9a54a;
}

.vm-row {
    height: 78px;
    margin-bottom: 6px;
    padding: 6px 10px;
    border-width: 1px;
    border-color: #334252;
    border-radius: 6px;
    background-color: #1b2530;
}

.vm-slot {
    display: inline-block;
    width: 58px;
    line-height: 62px;
    font-weight: bold;
    color: #ffd479;
    vertical-align: top;
}

.vm-info {
    display: inline-block;
    width: 440px;
    padding-top: 5px;
    vertical-align: top;
}

.vm-current {
    height: 20px;
    line-height: 20px;
    color: #e7eef6;
}

.vm-candidate {
    height: 19px;
    line-height: 19px;
    color: #a9bfd3;
}

.vm-materials {
    height: 18px;
    line-height: 18px;
    color: #8fa6bb;
    font-size: 12px;
}

.vm-duration {
    height: 18px;
    line-height: 18px;
    color: #7e94a8;
    font-size: 12px;
}

.vm-actions {
    display: inline-block;
    width: 200px;
    padding-top: 14px;
    text-align: right;
    vertical-align: top;
}

.vm-btn {
    display: inline-block;
    min-width: 46px;
    margin-left: 4px;
    padding: 4px 8px;
    border-width: 1px;
    border-color: #4c6075;
    border-radius: 4px;
    background-color: #293746;
    color: #e2eaf2;
    font-size: 13px;
    cursor: pointer;
}

.vm-btn:hover {
    background-color: #3b4d60;
}

.vm-install {
    border-color: #6f8d4f;
    background-color: #3c532a;
}

.vm-install:hover {
    background-color: #4d6a36;
}

.vm-remove {
    border-color: #8d5d4f;
    background-color: #59382c;
}

.vm-remove:hover {
    background-color: #704638;
}

.vm-hint {
    margin-top: 10px;
    color: #8fa6bb;
    font-size: 12px;
}
