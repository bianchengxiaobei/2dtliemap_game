body {
    font-family: zl_ui;
    font-size: 15px;
    color: #e6edf3;
    width: 100%;
    height: 100%;
}

#menu-overlay {
    position: absolute;
    left: 0px;
    top: 0px;
    width: 100%;
    height: 100%;
    background-color: #070c12e8;
}

.menu-view {
    position: absolute;
    left: 50%;
    top: 50%;
    display: none;
    padding: 30px 34px;
    background-color: #10161d;
    border-width: 1px;
    border-color: #3d566d;
    border-radius: 16px;
}

.menu-main {
    width: 440px;
    height: 556px;
    margin-left: -220px;
    margin-top: -278px;
}

.menu-pause {
    width: 408px;
    height: 430px;
    margin-left: -204px;
    margin-top: -215px;
}

.menu-settings {
    width: 760px;
    height: 590px;
    margin-left: -380px;
    margin-top: -295px;
}

.menu-brand {
    font-size: 13px;
    line-height: 20px;
    color: #5798c8;
    font-weight: bold;
}

.menu-kicker {
    font-size: 12px;
    line-height: 20px;
    color: #5798c8;
    font-weight: bold;
}

.menu-title {
    margin-top: 8px;
    font-size: 42px;
    line-height: 52px;
    color: #ffd479;
    font-weight: bold;
}

.menu-subtitle {
    margin-top: 4px;
    font-size: 13px;
    line-height: 20px;
    color: #9fb3c8;
}

.menu-accent {
    width: 64px;
    height: 3px;
    margin-top: 18px;
    margin-bottom: 24px;
    background-color: #2f6f9f;
    border-radius: 2px;
}

.menu-actions {
    width: 100%;
}

.menu-btn {
    display: block;
    width: 100%;
    height: 46px;
    line-height: 46px;
    margin-bottom: 10px;
    padding: 0 16px;
    background-color: #1a2834;
    border-width: 1px;
    border-color: #34495c;
    border-radius: 8px;
    color: #d7e2ec;
    font-size: 16px;
    text-align: center;
    cursor: pointer;
}

.menu-btn:hover {
    background-color: #243444;
    border-color: #52708b;
    color: #ffffff;
}

.menu-btn.primary {
    background-color: #2f6f9f;
    border-color: #5798c8;
    color: #ffffff;
    font-weight: bold;
}

.menu-btn.primary:hover {
    background-color: #3c86bb;
}

.menu-btn.danger {
    color: #ff9a8a;
}

.menu-btn.danger:hover {
    background-color: #3a2226;
    border-color: #8a4a4a;
    color: #ffb3a6;
}

.menu-btn.disabled,
.menu-btn.disabled:hover {
    background-color: #131d26;
    border-color: #263440;
    color: #5f7385;
    cursor: default;
}

.menu-hint {
    margin-top: 16px;
    font-size: 12px;
    line-height: 18px;
    color: #8fa4b8;
    text-align: center;
}

.menu-version {
    margin-top: 12px;
    font-size: 11px;
    line-height: 14px;
    color: #52677a;
    text-align: center;
}

.settings-title {
    margin-top: 6px;
    font-size: 32px;
    line-height: 40px;
    color: #ffd479;
    font-weight: bold;
}

.settings-subtitle {
    margin-top: 2px;
    font-size: 12px;
    line-height: 18px;
    color: #8fa4b8;
}

.settings-section {
    margin-top: 12px;
    margin-bottom: 6px;
    height: 22px;
    line-height: 22px;
    font-size: 13px;
    color: #9fb3c8;
    font-weight: bold;
    border-bottom-width: 1px;
    border-bottom-color: #263440;
}

.settings-volume-row {
    height: 36px;
    line-height: 36px;
}

.settings-volume-grid {
    width: 100%;
}

.settings-volume-cell {
    display: inline-block;
    width: 340px;
    height: 30px;
    line-height: 30px;
    vertical-align: top;
}

.settings-volume-cell .settings-label {
    width: 104px;
}

.settings-volume-cell input.range {
    width: 150px;
}

.settings-label {
    display: inline-block;
    width: 116px;
    font-size: 13px;
    color: #d7e2ec;
    vertical-align: top;
}

#setting-volume {
    width: 230px;
    height: 28px;
    margin-top: 4px;
    vertical-align: top;
}

.settings-value {
    display: inline-block;
    width: 40px;
    text-align: right;
    font-size: 13px;
    color: #ffd479;
    vertical-align: top;
}

.settings-note {
    margin-left: 12px;
    font-size: 11px;
    color: #6f8498;
    vertical-align: top;
}

.settings-columns {
    width: 100%;
}

.settings-column {
    display: inline-block;
    width: 340px;
    vertical-align: top;
}

.settings-column:last-child {
    margin-left: 16px;
}

.settings-row {
    height: 34px;
    line-height: 34px;
    border-bottom-width: 1px;
    border-bottom-color: #1b2732;
}

.settings-row .settings-label {
    width: 128px;
}

.key-btn {
    display: inline-block;
    width: 160px;
    height: 30px;
    line-height: 30px;
    margin-top: 4px;
    background-color: #0b1117;
    border-width: 1px;
    border-color: #34495c;
    border-radius: 6px;
    text-align: center;
    font-size: 13px;
    color: #e6edf3;
    vertical-align: top;
    cursor: pointer;
}

.key-btn:hover {
    border-color: #5798c8;
    background-color: #162430;
}

.key-btn.capturing {
    border-color: #ffd479;
    color: #ffd479;
    background-color: #2a2414;
}

.settings-footer {
    position: absolute;
    right: 34px;
    bottom: 46px;
    height: 40px;
}

.settings-footer .menu-btn {
    display: inline-block;
    width: 110px;
    margin-left: 10px;
    margin-bottom: 0px;
}

.menu-status {
    position: absolute;
    left: 34px;
    right: 180px;
    bottom: 100px;
    min-height: 20px;
    font-size: 13px;
    line-height: 20px;
    color: #ffd479;
}

.menu-status.status-ok {
    color: #7fe08a;
}

.menu-status.status-fail {
    color: #ff8a7a;
}
